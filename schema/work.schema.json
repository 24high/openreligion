{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Werk (religiöser oder wissenschaftlicher Grundtext)",
  "description": "Metadaten eines Textwerks samt Zitierschema und Ausgaben. Datei: data/works/<slug>.md. Volltexte liegen getrennt unter data/texts/<slug>/<edition>/<division>.json",
  "type": "object",
  "required": ["id", "type", "title", "traditions", "citation", "editions", "review_status"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/workId" },
    "type": { "const": "work" },
    "title": { "$ref": "common.schema.json#/$defs/langText" },
    "summary": { "$ref": "common.schema.json#/$defs/langText" },
    "traditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/traditionId" }
    },
    "citation": {
      "description": "Wie Stellen in diesem Werk adressiert werden.",
      "type": "object",
      "required": ["locus_pattern", "example"],
      "additionalProperties": false,
      "properties": {
        "standard": { "description": "Externer Standard, an den sich das Schema anlehnt (OSIS, Sefaria, SuttaCentral …)", "type": "string" },
        "locus_pattern": { "description": "Regulärer Ausdruck für gültige Loci; der Validator prüft jede Referenz dagegen.", "type": "string" },
        "example": { "type": "string" },
        "explanation": { "$ref": "common.schema.json#/$defs/langText" }
      }
    },
    "editions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "lang", "title", "license"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/slug" },
          "lang": { "$ref": "common.schema.json#/$defs/langTag" },
          "title": { "type": "string" },
          "license": {
            "description": "reference-only = urheberrechtlich geschützt, nur Stellenangaben, kein Volltext im Repo",
            "enum": ["public-domain", "cc0", "cc-by", "cc-by-sa", "other", "reference-only"]
          },
          "license_note": { "type": "string" },
          "source_url": { "type": "string", "pattern": "^https?://" },
          "in_corpus": { "description": "Liegt (Teil-)Volltext unter data/texts/?", "type": "boolean" }
        }
      }
    },
    "external_ids": { "$ref": "common.schema.json#/$defs/externalIds" },
    "tags": { "$ref": "common.schema.json#/$defs/tags" },
    "review_status": { "$ref": "common.schema.json#/$defs/reviewStatus" },
    "superseded_by": { "$ref": "common.schema.json#/$defs/workId" }
  }
}
