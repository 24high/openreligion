{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenReligion – gemeinsame Definitionen",
  "description": "Bausteine, die alle Entitätsschemas per $ref verwenden.",
  "$defs": {
    "anyEntityId": {
      "description": "Typ-Präfix + Slug-Pfad. Der Pfad bestimmt die Datei: claim:christianity/golden-rule -> data/claims/christianity/golden-rule.md",
      "type": "string",
      "pattern": "^(tradition|work|claim|interpretation|argument|consensus):[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "traditionId": { "type": "string", "pattern": "^tradition:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$" },
    "workId": { "type": "string", "pattern": "^work:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$" },
    "claimId": { "type": "string", "pattern": "^claim:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$" },
    "votableId": {
      "description": "Alles, worüber abgestimmt werden kann.",
      "type": "string",
      "pattern": "^(claim|interpretation|argument|consensus):[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "passageRef": {
      "description": "Textstelle: <work-id>#<locus>. Das Locus-Format legt das Werk in citation.locus_pattern fest, z. B. work:bible#Matt.7.12 oder work:quran#112.1-4",
      "type": "string",
      "pattern": "^work:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*#[A-Za-z0-9]+(?:[.:\\-][A-Za-z0-9]+)*$"
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "langTag": { "description": "BCP-47-Sprachcode, z. B. de, en, ar, he, pi", "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "langText": {
      "description": "Mehrsprachiger Text: { \"de\": \"…\", \"en\": \"…\" }. Mindestens eine Sprache.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/langTag" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "login": { "description": "GitHub-Login", "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$" },
    "reviewStatus": {
      "description": "draft = ungeprüft, reviewed = von Kurator:innen geprüft, disputed = Darstellung strittig, deprecated = ersetzt (siehe superseded_by)",
      "enum": ["draft", "reviewed", "disputed", "deprecated"]
    },
    "relation": {
      "type": "object",
      "required": ["type", "target"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "parallels/contradicts sind symmetrisch; die übrigen gerichtet (Quelle -> Ziel).",
          "enum": ["parallels", "contradicts", "refines", "derives-from", "supports", "challenges", "same-as"]
        },
        "target": { "$ref": "#/$defs/anyEntityId" },
        "note": { "$ref": "#/$defs/langText" }
      }
    },
    "citation": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string" },
        "title": { "type": "string" },
        "year": { "type": "integer" },
        "container": { "description": "Zeitschrift, Sammelband, Website", "type": "string" },
        "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
        "isbn": { "type": "string" },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "source": {
      "description": "Beleg: entweder eine Textstelle (ref) oder eine bibliografische Angabe (citation).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": { "$ref": "#/$defs/passageRef" },
        "citation": { "$ref": "#/$defs/citation" },
        "note": { "$ref": "#/$defs/langText" }
      },
      "oneOf": [
        { "required": ["ref"], "not": { "required": ["citation"] } },
        { "required": ["citation"], "not": { "required": ["ref"] } }
      ]
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "tags": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
    "externalIds": {
      "type": "object",
      "properties": { "wikidata": { "type": "string", "pattern": "^Q\\d+$" } },
      "additionalProperties": { "type": "string" }
    }
  }
}
